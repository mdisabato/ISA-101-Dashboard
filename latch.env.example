# Copy to latch.env (ignored by git) and fill in.
HA_HOST=homeassistant.local      # host running the SSH app
HA_USER=hassio                   # SSH user with passwordless sudo -n
HA_SSH_PORT=22
HA_SSH_KEY=~/.ssh/id_ed25519     # optional; leave empty to use your SSH defaults
DASHBOARD=dashboard_test         # storage name: lovelace.<this> in /config/.storage
# LATCH_FILE=/config/templates/template_isa_alarm_latch.yaml
